{
  "name": "air-dj",
  "version": "1.0.0",
  "private": true,
  "description": "Play songs with your hands in front of a webcam, with live effects, visuals and MP4 recording. Runs in Chrome.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "globals": "17.14.0"
  },
  "engines": {
    "node": ">=22"
  }
}
